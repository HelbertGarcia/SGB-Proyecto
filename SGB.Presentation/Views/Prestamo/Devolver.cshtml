@model SGB.Presentation.Models.PrestamoModels.PrestamoDevolucionModel

@{
    ViewData["Title"] = "Devolucion de Prestamo";
}

<h1>Devolucion de Prestamo</h1>

<h4>   Rellene  estos campos para realizar la devolucion de un prestamo </h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Devolver">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IdPrestamo" class="control-label"></label>
                <input asp-for="IdPrestamo" class="form-control" />
                <span asp-validation-for="IdPrestamo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaDevolucion" class="control-label"></label>
                <input asp-for="FechaDevolucion" class="form-control" />
                <span asp-validation-for="FechaDevolucion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
