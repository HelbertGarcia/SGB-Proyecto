@model IEnumerable<SGB.Presentation.Models.PrestamoModel>

@{
    ViewData["Title"] = "Prestamos";
}

<h1>Lista de Prestamos</h1>

<p>
    <a asp-action="Create">Create nuevo Prestamo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fechaInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fechaFin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fechaDevolucion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.estaActivo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.usuarioId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.isbn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaInicio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaFin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fechaDevolucion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.estado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.estaActivo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.usuarioId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.isbn)
            </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-primary me-2">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-info me-2">Detalles</a>

                    @if (item.estaActivo)
                    {
                        <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-sm btn-danger me-2">Eliminar</a>
                        <a asp-action="Devolver" asp-route-id="@item.id" class="btn btn-sm btn-warning">Devolver</a>
                    }
                </td>
        </tr>
}
    </tbody>
</table>
