@model IEnumerable<SGB.Presentation.Models.ConfiguracionModel>

@{
    ViewData["Title"] = "Lista de Configuraciones";
}

<h1>Lista de Configuraciones</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nueva</a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().IDConfiguracion)</th>
                <th>@Html.DisplayNameFor(model => model.First().Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.First().Valor)</th>
                <th>@Html.DisplayNameFor(model => model.First().Descripcion)</th>
                <th>@Html.DisplayNameFor(model => model.First().FechaCreacion)</th>
                <th>@Html.DisplayNameFor(model => model.First().EstaActivo)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item?.IDConfiguracion</td>
                    <td>@item?.Nombre</td>
                    <td>@item?.Valor</td>
                    <td>@item?.Descripcion</td>
                    <td>@item.FechaCreacion.ToString("yyyy-MM-dd HH:mm")
            </td>
            <td>@(item?.EstaActivo == true ? "Sí" : "No")</td>
            <td>
                @Html.ActionLink("Editar", "Edit", new { id = item.IDConfiguracion }, new { @class = "btn btn-warning btn-sm" })|
                @Html.ActionLink("Detalles", "Details", new { id = item?.IDConfiguracion }, new { @class = "btn btn-info btn-sm" })
            </td>
        </tr>
                }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No hay configuraciones disponibles.</div>
}
