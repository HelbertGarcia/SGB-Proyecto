@model List<SGB.Presentation.Models.ConfiguracionModel>

@{
    ViewBag.Title = "Lista de Configuraciones";
}

<h2>Lista de Configuraciones</h2>

<a asp-action="Create" class="btn btn-primary">Create New</a>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>IDConfiguracion</th>
                <th>Nombre</th>
                <th>Valor</th>
                <th>Descripcion</th>
                <th>FechaCreacion</th>
                <th>EstaActivo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IDConfiguracion</td>
                    <td>@item.Nombre</td>
                    <td>@item.Valor</td>
                    <td>@item.Descripcion</td>
                    <td>@item.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(item.EstaActivo ? "Sí" : "No")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.IDConfiguracion" class="btn btn-info btn-sm">Ver</a>
                        <a asp-action="Edit" asp-route-id="@item.IDConfiguracion" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IDConfiguracion" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning mt-3">No hay configuraciones registradas.</div>
}
