@model SGB.Presentation.Models.ConfiguracionModel

@{
    ViewData["Title"] = "Detalles de Configuración";
}

<h1>Detalles de Configuración</h1>

<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.IDConfiguracion)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.IDConfiguracion)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.Nombre)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Nombre)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.Valor)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Valor)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.Descripcion)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Descripcion)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.FechaCreacion)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.FechaCreacion)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.EstaActivo)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.EstaActivo)
    </dd>
</dl>

<div>
    @Html.ActionLink("Editar", "Edit", new { id = Model.IDConfiguracion }, new { @class = "btn btn-primary" })
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
